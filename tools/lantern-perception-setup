#!/bin/bash
# One-time setup for object detection: installs Ultralytics, downloads the
# YOLO weights and builds a TensorRT engine for this Jetson.
#   lantern-perception-setup            # yolo11n (fastest, the default)
#   lantern-perception-setup yolo11s    # bigger, more accurate, slower
# Needs internet. Takes a few minutes (the TensorRT build is the slow part).
set -e
MODEL=${1:-yolo11n}
DIR=${LANTERN_MODELS:-/home/lantern/lantern/models}
G='\e[32m'; R='\e[31m'; Y='\e[33m'; N='\e[0m'

if curl -s --max-time 2 localhost:8080/api/state | grep -q '"armed": true'; then
  echo "Drone is ARMED - refusing (the engine build loads the GPU). Disarm first."; exit 1
fi

echo "==> PyTorch with CUDA"
if ! python3 -c "import torch, sys; sys.exit(0 if torch.cuda.is_available() else 1)" 2>/dev/null; then
  echo -e "  ${R}✗${N} PyTorch with CUDA is not installed for python3."
  echo "    A plain 'pip install torch' does NOT use the Jetson GPU."
  echo "    Install the JetPack 6 PyTorch + torchvision wheels first (see the"
  echo "    Ultralytics 'NVIDIA Jetson' guide or NVIDIA's 'PyTorch for Jetson'),"
  echo "    then run this again."
  exit 1
fi
echo -e "  ${G}✓${N} $(python3 -c 'import torch; print("torch", torch.__version__, "on", torch.cuda.get_device_name(0))')"

echo "==> TensorRT"
python3 -c "import tensorrt; print('  tensorrt', tensorrt.__version__)" 2>/dev/null \
  || echo -e "  ${Y}!${N} tensorrt python module not found - will fall back to the .pt model (slower)"

echo "==> Ultralytics"
if ! python3 -c "import ultralytics" 2>/dev/null; then
  # numpy<2: ROS Humble's OpenCV/cv_bridge on Ubuntu 22.04 are built for NumPy 1.x
  pip3 install --user "ultralytics" "onnx" "onnxslim" "numpy<2"
fi
pip3 install --user -q "numpy<2"
python3 -c "import ultralytics; print('  ultralytics', ultralytics.__version__)"
python3 -c "import cv2, numpy; print('  opencv', cv2.__version__, '· numpy', numpy.__version__)" || {
  echo -e "  ${R}✗${N} OpenCV broke after installing ultralytics - paste this output to Claude."; exit 1; }
# make sure pip didn't swap the Jetson torch for a CPU build
python3 -c "import torch, sys; sys.exit(0 if torch.cuda.is_available() else 1)" || {
  echo -e "  ${R}✗${N} torch lost CUDA after installing ultralytics - reinstall the Jetson torch wheel."; exit 1; }

echo "==> Model $MODEL"
mkdir -p "$DIR"
cd "$DIR"
python3 - "$MODEL" <<'EOF'
import sys
from pathlib import Path
from ultralytics import YOLO
name = sys.argv[1]
m = YOLO(name + '.pt')                       # downloads into this folder
try:
    import tensorrt  # noqa: F401
    out = m.export(format='engine', half=True, imgsz=640, device=0)
    print('  built', out)
except ImportError:
    print('  no TensorRT: using', name + '.pt')
EOF

# point the service at this model (keeps any other settings in the file)
ENVF=/etc/lantern/perception.env
sudo mkdir -p /etc/lantern; sudo touch $ENVF
sudo sed -i '/^LANTERN_MODEL=/d' $ENVF
echo "LANTERN_MODEL=$DIR/$MODEL.engine" | sudo tee -a $ENVF >/dev/null
echo "  LANTERN_MODEL set in $ENVF (falls back to $MODEL.pt if no engine)"

echo "==> Restarting lantern-perception"
sudo systemctl restart lantern-perception && echo -e "  ${G}✓${N} restarted (flight stack untouched)"
echo "Open the dashboard → Cameras to see detections."
